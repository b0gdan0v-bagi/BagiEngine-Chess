      <srcRect x="735" y="257" w="244" h="256" />
      <atlas name="pieces">
        <source texturePath="assets/artgen/WhiteKing.png">
          <rect x="0" y="0" w="244" h="256" />
        </source>
        <pack padding="1" sizeMode="PowerOfTwo" maxSide="1024" />
      </atlas>
    </sprite>
