<?xml version="1.0"?>
<!-- The promotion panel: a modal canvas over everything (layer 20, like the opponent panel), started hidden. A click on a promotion target does not move the pawn: the model
     leaves the promotion pending (ChessGameModel::HasPendingPromotion) and ChessBoardComponent shows this canvas for as long as it is, on every update, so a reset, a set_state or
     a move of the program or of the control API closes a panel that has become stale. A piece button emits ChessPromote with the id of the piece as the value ("queen", "rook",
     "bishop", "knight": the table of PromotionChoices) and plays the move; Cancel emits ChessCancelPromotion and the pawn stays selected. While it is shown the dim takes every
     click, so the board and the buttons of the HUD under it get none. The dim is a button of its own that does what Cancel does (ChessCancelPromotion), so a click beside
     the plate cancels; its clicker has stateLook="false", or the dim would lighten under the pointer. Escape is not wired. Plain text buttons, no pieces drawn in them. The names
     start with Promotion or Promote because elements are found by name in every canvas of the scene (the opponent panel has Dim, Plate and Title). The four piece buttons share
     one row. The plate is 94% of the safe area up to 640 units, and 94% of even the narrowest safe area (about 689 units, so 647) is more than 640: the plate is 640 wide in
     every window of the size matrix with the default view, 608 inside the padding, so a button is 146 units wide and keeps 8 units of air around "Knight" at font 26 there
     (ChessUiTest holds it). The plate is 16 + 44 (title) + 56 (pieces) + 56 (Cancel) + 3 x 12 (spacing) + 16 = 224 units high.
     In the Portrait view (720 wide) the plate is 640 too, but in the narrowest window the safe area is 590 units and the plate 555, a button 124 units wide: it still fits, and
     the height fits both views. The plate is centered in the safe area of either view and does not move with the turn of the board. -->
<node name="PromotionPanel" layer="20" contentVersion="5">
  <components>
    <component type="ChessPromotionPanelComponent" />
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIElement" name="PromotionDim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,150" blocksInput="true">
          <components>
            <component type="UIInputClicker" action="ChessCancelPromotion" stateLook="false"/>
          </components>
        </element>
        <element type="UIStack" name="PromotionPlate" anchor="Center" width="94%" maxWidth="640" height="224" direction="Vertical" spacing="12" padding="16" crossAlign="Stretch" color="44,38,52,255" blocksInput="true">
          <children>
            <element type="UIElement" name="PromotionTitle" height="44" fontSize="30">
              <components>
                <component type="UITextComponent" text="Promote to" align="Center"/>
              </components>
            </element>
            <element type="UIStack" name="PromotionPieces" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="PromoteQueen" flex="1" height="56" fontSize="26" color="70,70,100,255">
                  <components>
                    <component type="UITextComponent" text="Queen" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessPromote" value="queen"/>
                  </components>
                </element>
                <element type="UIElement" name="PromoteRook" flex="1" height="56" fontSize="26" color="70,70,100,255">
                  <components>
                    <component type="UITextComponent" text="Rook" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessPromote" value="rook"/>
                  </components>
                </element>
                <element type="UIElement" name="PromoteBishop" flex="1" height="56" fontSize="26" color="70,70,100,255">
                  <components>
                    <component type="UITextComponent" text="Bishop" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessPromote" value="bishop"/>
                  </components>
                </element>
                <element type="UIElement" name="PromoteKnight" flex="1" height="56" fontSize="26" color="70,70,100,255">
                  <components>
                    <component type="UITextComponent" text="Knight" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessPromote" value="knight"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIElement" name="PromotionCancel" height="56" fontSize="26" color="110,60,60,255">
              <components>
                <component type="UITextComponent" text="Cancel" align="Center" verticalAlign="Center" wrap="false"/>
                <component type="UIInputClicker" action="ChessCancelPromotion"/>
              </components>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
