<?xml version="1.0"?>
<!-- The menu section "Sound": the master volume and the mute. A modal canvas over everything (layer 20, above the HUD and the end-of-game bar), started hidden, built like the opponent
     panel: the Sound button of the menu list shows it (ChessOpenSection, value sound: the row of Game/MenuSections.cpp); the one button, Back, returns to the list (ChessOpenMenu)
     and fills its row; the dim is a button of its own that hides both (ChessCloseMenu) with stateLook="false", always the first child. The slider (ChessSetVolume) and the switch of the mute row
     (ChessSetMute) carry their own actions; the widgets own no level: they show the variables soundVolume, soundVolumeText and soundMuted, which ChessSoundPanelComponent (listed before the canvas, so the words are there in the frame
     it shows) writes. The slider's step is the same number as kVolumeStep (Sound/SoundLevels.h). Only the master has a row: the buses Sfx and Ui keep the level of the audio config.
     Every name starts with SoundPanel because elements are found by name in every canvas of the scene (Dim, Plate and Title are the opponent panel's). The rows are 56 units, the
     touch size of every control, and the caption of the volume is as wide as the opponent panel's captions. The plate is 94% of the safe area up to 640 units, centered:
     16 + 44 (title) + 56 (volume) + 56 (mute) + 56 (Back) + 3 x 12 (spacing) + 16 = 280 units high. The slider takes what the caption (150) and the value (72) leave of the
     narrowest Portrait window (94% of 590 safe units), so the panel needs no variant. The slider has square parts: with partShape="Round" a steady frame with the panel open allocates in ChessUiAllocTest (the pill is drawn as
     geometry). -->
<node name="SoundPanel" layer="20" contentVersion="5">
  <components>
    <component type="ChessSoundPanelComponent" />
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIElement" name="SoundPanelDim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,150" blocksInput="true">
          <components>
            <component type="UIInputClicker" action="ChessCloseMenu" stateLook="false"/>
          </components>
        </element>
        <element type="UIStack" name="SoundPanelPlate" anchor="Center" width="94%" maxWidth="640" height="280" direction="Vertical" spacing="12" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UIElement" name="SoundPanelTitle" height="44" fontSize="30">
              <components>
                <component type="UITextComponent" text="Sound" align="Center"/>
              </components>
            </element>
            <element type="UIStack" name="SoundPanelVolumeRow" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="SoundPanelVolumeCaption" width="150" height="56" fontSize="24">
                  <components>
                    <component type="UITextComponent" text="Volume" verticalAlign="Center" wrap="false"/>
                  </components>
                </element>
                <element type="UIElement" name="SoundPanelVolume" flex="1" height="56">
                  <components>
                    <component type="UIInputClicker" stateLook="false"/>
                    <component type="UISliderComponent" bind="soundVolume" action="ChessSetVolume" minValue="0" maxValue="1" step="0.1"/>
                  </components>
                </element>
                <element type="UIElement" name="SoundPanelVolumeValue" width="72" height="56" fontSize="24">
                  <components>
                    <component type="UITextComponent" text="{soundVolumeText}" align="Right" verticalAlign="Center" wrap="false"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIElement" name="SoundPanelMuteRow" height="56" layout="Stack" direction="Horizontal" spacing="8" crossAlign="Center">
              <components>
                <component type="UIInputClicker"/>
                <component type="UIToggleComponent" bind="soundMuted" action="ChessSetMute" onValue="1" offValue="0"/>
              </components>
              <children>
                <element type="UIElement" name="SoundPanelMuteCaption" flex="1" height="100%" fontSize="24">
                  <components>
                    <component type="UITextComponent" text="Mute" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                  </components>
                </element>
                <element type="UIElement" name="SoundPanelMuteSwitch" height="100%" aspectRatio="1.25">
                  <components>
                    <component type="UISwitchComponent"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIStack" name="SoundPanelButtons" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="SoundPanelBack" flex="1" height="56" fontSize="26" color="50,115,85,255">
                  <components>
                    <component type="UITextComponent" text="Back" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessOpenMenu"/>
                  </components>
                </element>
              </children>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
