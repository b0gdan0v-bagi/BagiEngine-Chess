<?xml version="1.0"?>
<!-- The menu: a list of sections, a modal canvas over everything (layer 20, above the HUD and the end-of-game bar), started hidden. The Menu button of the HUD shows it
     (ChessOpenMenu); a section button hides it and shows the canvas of the section (ChessOpenSection, the id of the section as the value: the table of MenuSections, which
     ChessBoardComponent hides and shows the canvases through); Close hides it (ChessCloseMenu). The list and a section panel replace one another; while one is shown its dim
     takes every click, so the board and the HUD under it get none, and there is no Escape and no click outside. Only the sections the game has are here: a feature that
     does not exist yet has no button. Every name starts with Menu because elements are found by name in every canvas of the scene (the HUD button is the only one called
     exactly Menu). The sections are one 56-unit button MenuSection<Name> each, in the order of MenuSections(). To add a section: a row in Game/MenuSections.cpp, a
     MenuSection<Name> button here (and 68 units more in the height of MenuPlate: 56 for the button and 12 for the gap) and the panel node of the row. The plate is 94% of
     the safe area up to 640 units: 16 + 44 (title) + 56 (Opponent) + 56 (Close) + 3 x 12 (spacing) + 16 = 224 units high.
     The plate is centered in the safe area of either view (840 x 800 or Portrait 720 x 960) and needs no variant: it is 224 units high, and the buttons fit the 555 units of the
     narrowest Portrait window (94% of its 590 safe units) as well as the 640 of the default view. -->
<node name="MenuPanel" layer="20" contentVersion="5">
  <components>
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIElement" name="MenuDim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,150" blocksInput="true" />
        <element type="UIStack" name="MenuPlate" anchor="Center" width="94%" maxWidth="640" height="224" direction="Vertical" spacing="12" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UIElement" name="MenuTitle" height="44" fontSize="30">
              <components>
                <component type="UITextComponent" text="Menu" align="Center"/>
              </components>
            </element>
            <element type="UIElement" name="MenuSectionOpponent" height="56" fontSize="26" color="70,70,100,255">
              <components>
                <component type="UITextComponent" text="Opponent" align="Center" verticalAlign="Center" wrap="false"/>
                <component type="UIInputClicker" action="ChessOpenSection" value="opponent"/>
              </components>
            </element>
            <element type="UIElement" name="MenuClose" height="56" fontSize="26" color="110,60,60,255">
              <components>
                <component type="UITextComponent" text="Close" align="Center" verticalAlign="Center" wrap="false"/>
                <component type="UIInputClicker" action="ChessCloseMenu"/>
              </components>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
