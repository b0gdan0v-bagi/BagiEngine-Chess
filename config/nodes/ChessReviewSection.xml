<?xml version="1.0"?>
<!-- The menu section "Review": the status line of the review of a finished game and its Start and Cancel. A modal canvas over everything (layer 20, above the HUD and the end-of-game bar),
     started hidden, built like the section "Puzzles": the Review button of the menu list shows it (ChessOpenSection, value review: the row of Game/MenuSections.cpp); the one button Back
     returns to the list (ChessOpenMenu) and fills its row; the dim is a button of its own that hides both (ChessCloseMenu) with stateLook="false", always the first child.
     ChessReviewSectionComponent (listed before the canvas) answers ChessReviewStart and ChessReviewCancel, which the result bar presses too, writes {reviewStatus} and greys Start (the rule of
     who may start) and Cancel (no review is held) with the clicker's disabled and the text's fadeWhenDisabled; the file starts with Start live and Cancel grey, the game's start. The plate
     holds five rows, none of them hidden: 16 + 44 (title) + 44 (the status line) + 3 x 56 (Start, Cancel, Back) + 4 x 12 (spacing) + 16 = 336 units high, which the safe area of every
     view has. Every name starts with ReviewSection because elements are found by name in every canvas of the scene. -->
<node name="ReviewSection" layer="20" contentVersion="5">
  <components>
    <component type="ChessReviewSectionComponent" />
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIElement" name="ReviewSectionDim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,150" blocksInput="true">
          <components>
            <component type="UIInputClicker" action="ChessCloseMenu" stateLook="false"/>
          </components>
        </element>
        <element type="UIStack" name="ReviewSectionPlate" anchor="Center" width="94%" maxWidth="640" height="336" direction="Vertical" spacing="12" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UIElement" name="ReviewSectionTitle" height="44" fontSize="30">
              <components>
                <component type="UITextComponent" text="Review" align="Center"/>
              </components>
            </element>
            <element type="UIElement" name="ReviewSectionStatus" height="44" fontSize="28">
              <components>
                <component type="UITextComponent" text="{reviewStatus}" align="Center" verticalAlign="Center" wrap="false"/>
              </components>
            </element>
            <element type="UIElement" name="ReviewSectionStart" height="56" fontSize="26" color="50,115,85,255">
              <components>
                <component type="UITextComponent" text="Start review" align="Center" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                <component type="UIInputClicker" action="ChessReviewStart"/>
              </components>
            </element>
            <element type="UIElement" name="ReviewSectionCancel" height="56" fontSize="26" color="112,84,48,255">
              <components>
                <component type="UITextComponent" text="Cancel" align="Center" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                <component type="UIInputClicker" action="ChessReviewCancel" disabled="true"/>
              </components>
            </element>
            <element type="UIElement" name="ReviewSectionBack" height="56" fontSize="26" color="50,115,85,255">
              <components>
                <component type="UITextComponent" text="Back" align="Center" verticalAlign="Center" wrap="false"/>
                <component type="UIInputClicker" action="ChessOpenMenu"/>
              </components>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
