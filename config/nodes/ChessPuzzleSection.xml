<?xml version="1.0"?>
<!-- The menu section "Puzzles": Start / Next, Retry and Leave of the puzzle mode and the three lines that say which puzzle is on. A modal canvas over everything (layer 20, above the HUD and the
     end-of-game bar), started hidden, built like the sections "Game" and "Position": the Puzzles button of the menu list shows it (ChessOpenSection, value puzzles: the row of
     Game/MenuSections.cpp); the one button Back returns to the list (ChessOpenMenu) and fills its row; the dim is a button of its own that hides both (ChessCloseMenu) with stateLook="false",
     always the first child. ChessPuzzleSectionComponent (listed before the canvas) answers ChessPuzzleNext (the one button of Start and Next: its word is {puzzleNextWord}), ChessPuzzleRetry and
     ChessPuzzleLeave, which the puzzle bar presses too, writes {puzzleNumber}, {puzzleRating} and {puzzleState} and greys Start / Next (an empty set) and Retry and Leave (no puzzle is on) with
     the clicker's disabled and the text's fadeWhenDisabled. The plate holds seven rows, none of them hidden: 16 + 44 (title) + 3 x 44 (the lines) + 56 (Start / Next) + 56 (Retry and Leave)
     + 56 (Back) + 6 x 12 (spacing) + 16 = 448 units high, which the safe area of every view has. Every name starts with PuzzleSection because elements are found by name in every canvas
     of the scene. -->
<node name="PuzzleSection" layer="20" contentVersion="5">
  <components>
    <component type="ChessPuzzleSectionComponent" />
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIElement" name="PuzzleSectionDim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,150" blocksInput="true">
          <components>
            <component type="UIInputClicker" action="ChessCloseMenu" stateLook="false"/>
          </components>
        </element>
        <element type="UIStack" name="PuzzleSectionPlate" anchor="Center" width="94%" maxWidth="640" height="448" direction="Vertical" spacing="12" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UIElement" name="PuzzleSectionTitle" height="44" fontSize="30">
              <components>
                <component type="UITextComponent" text="Puzzles" align="Center"/>
              </components>
            </element>
            <element type="UIElement" name="PuzzleSectionNumber" height="44" fontSize="28">
              <components>
                <component type="UITextComponent" text="{puzzleNumber}" align="Center" verticalAlign="Center" wrap="false"/>
              </components>
            </element>
            <element type="UIElement" name="PuzzleSectionRating" height="44" fontSize="28">
              <components>
                <component type="UITextComponent" text="{puzzleRating}" align="Center" verticalAlign="Center" wrap="false"/>
              </components>
            </element>
            <element type="UIElement" name="PuzzleSectionState" height="44" fontSize="28">
              <components>
                <component type="UITextComponent" text="{puzzleState}" align="Center" verticalAlign="Center" wrap="false"/>
              </components>
            </element>
            <element type="UIElement" name="PuzzleSectionNext" height="56" fontSize="26" color="50,115,85,255">
              <components>
                <component type="UITextComponent" text="{puzzleNextWord}" align="Center" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                <component type="UIInputClicker" action="ChessPuzzleNext"/>
              </components>
            </element>
            <element type="UIStack" name="PuzzleSectionActions" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="PuzzleSectionRetry" flex="1" height="56" fontSize="26" color="70,70,100,255">
                  <components>
                    <component type="UITextComponent" text="Retry" align="Center" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                    <component type="UIInputClicker" action="ChessPuzzleRetry"/>
                  </components>
                </element>
                <element type="UIElement" name="PuzzleSectionLeave" flex="1" height="56" fontSize="26" color="112,84,48,255">
                  <components>
                    <component type="UITextComponent" text="Leave" align="Center" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                    <component type="UIInputClicker" action="ChessPuzzleLeave"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIStack" name="PuzzleSectionButtons" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="PuzzleSectionBack" flex="1" height="56" fontSize="26" color="50,115,85,255">
                  <components>
                    <component type="UITextComponent" text="Back" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessOpenMenu"/>
                  </components>
                </element>
              </children>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
