<?xml version="1.0"?>
<!-- The menu section "Position": where a position is set up on the board and what the position holds that the pieces do not. A modal canvas over everything (layer 20, above the HUD
     and the end-of-game bar), started hidden, built like the section "Game": the Position button of the menu list shows it (ChessOpenSection, value position: the row of
     Game/MenuSections.cpp), the editor bar shows it too while a position is edited; the one button, Back, returns to the list (ChessOpenMenu) and fills its row; the dim is a button of its
     own that hides both (ChessCloseMenu) with stateLook="false", always the first child. ChessPositionSectionComponent (listed before the canvas) answers ChessEditBegin (value current, empty or
     start), ChessEditSide (value white or black), ChessEditCastle (value +K, -K, +Q, -Q, +k, -k, +q or -q), ChessEditCopy, ChessEditPaste, ChessEditPlay and ChessEditCancel; it owns no state: the side and the four castling
     switches show the variables editorBlackToMove and editorCastle<K|Q|k|q>, and {editorMessage} is the reason the last Play or Paste was refused, or what the clipboard said. A control that needs an open editor is greyed (the clicker's
     disabled and the text's fadeWhenDisabled) while none is, and a castling switch while its king and rook are not on their squares. The pieces are not placed here: a modal panel hides the board,
     so they are put from the editor bar. Two-column rows keep the plate low: 16 + 44 (title) + 56 (Edit this position) + 56 (Empty board, Start position) + 56 (Copy FEN, Paste FEN) + 56 (the side) + 56 + 56 (the four
     castling switches) + 28 (the message) + 56 (Play from here, Cancel editing) + 56 (Back) + 9 x 8 (spacing) + 16 = 624 units high, which the safe area of every view has. The plate is 94% of
     the safe area up to 640 units, so a column of the narrowest Portrait window (94% of 590 safe units) is 257 units. Every name starts with PositionSection because elements are found by name in every canvas
     of the scene. -->
<node name="PositionSection" layer="20" contentVersion="5">
  <components>
    <component type="ChessPositionSectionComponent" />
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIElement" name="PositionSectionDim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,150" blocksInput="true">
          <components>
            <component type="UIInputClicker" action="ChessCloseMenu" stateLook="false"/>
          </components>
        </element>
        <element type="UIStack" name="PositionSectionPlate" anchor="Center" width="94%" maxWidth="640" height="624" direction="Vertical" spacing="8" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UIElement" name="PositionSectionTitle" height="44" fontSize="30">
              <components>
                <component type="UITextComponent" text="Position" align="Center"/>
              </components>
            </element>
            <element type="UIElement" name="PositionSectionCurrent" height="56" fontSize="26" color="70,70,100,255">
              <components>
                <component type="UITextComponent" text="Edit this position" align="Center" verticalAlign="Center" wrap="false"/>
                <component type="UIInputClicker" action="ChessEditBegin" value="current"/>
              </components>
            </element>
            <element type="UIStack" name="PositionSectionStarts" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="PositionSectionEmpty" flex="1" height="56" fontSize="26" color="70,70,100,255">
                  <components>
                    <component type="UITextComponent" text="Empty board" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessEditBegin" value="empty"/>
                  </components>
                </element>
                <element type="UIElement" name="PositionSectionStart" flex="1" height="56" fontSize="26" color="70,70,100,255">
                  <components>
                    <component type="UITextComponent" text="Start position" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessEditBegin" value="start"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIStack" name="PositionSectionClipboard" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="PositionSectionCopy" flex="1" height="56" fontSize="26" color="70,70,100,255">
                  <components>
                    <component type="UITextComponent" text="Copy FEN" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessEditCopy"/>
                  </components>
                </element>
                <element type="UIElement" name="PositionSectionPaste" flex="1" height="56" fontSize="26" color="70,70,100,255">
                  <components>
                    <component type="UITextComponent" text="Paste FEN" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessEditPaste"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIElement" name="PositionSectionSideRow" height="56" layout="Stack" direction="Horizontal" spacing="8" crossAlign="Center">
              <components>
                <component type="UIInputClicker"/>
                <component type="UIToggleComponent" bind="editorBlackToMove" action="ChessEditSide" onValue="black" offValue="white"/>
              </components>
              <children>
                <element type="UIElement" name="PositionSectionSideCaption" flex="1" height="100%" fontSize="24">
                  <components>
                    <component type="UITextComponent" text="Black to move" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                  </components>
                </element>
                <element type="UIElement" name="PositionSectionSideSwitch" height="100%" aspectRatio="1.25">
                  <components>
                    <component type="UISwitchComponent"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIStack" name="PositionSectionCastlesWhite" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="PositionSectionCastleKRow" flex="1" height="56" layout="Stack" direction="Horizontal" spacing="8" crossAlign="Center">
                  <components>
                    <component type="UIInputClicker"/>
                    <component type="UIToggleComponent" bind="editorCastleK" action="ChessEditCastle" onValue="+K" offValue="-K"/>
                  </components>
                  <children>
                    <element type="UIElement" name="PositionSectionCastleKCaption" flex="1" height="100%" fontSize="22">
                      <components>
                        <component type="UITextComponent" text="White O-O" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                      </components>
                    </element>
                    <element type="UIElement" name="PositionSectionCastleKSwitch" height="100%" aspectRatio="1.25">
                      <components>
                        <component type="UISwitchComponent"/>
                      </components>
                    </element>
                  </children>
                </element>
                <element type="UIElement" name="PositionSectionCastleQRow" flex="1" height="56" layout="Stack" direction="Horizontal" spacing="8" crossAlign="Center">
                  <components>
                    <component type="UIInputClicker"/>
                    <component type="UIToggleComponent" bind="editorCastleQ" action="ChessEditCastle" onValue="+Q" offValue="-Q"/>
                  </components>
                  <children>
                    <element type="UIElement" name="PositionSectionCastleQCaption" flex="1" height="100%" fontSize="22">
                      <components>
                        <component type="UITextComponent" text="White O-O-O" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                      </components>
                    </element>
                    <element type="UIElement" name="PositionSectionCastleQSwitch" height="100%" aspectRatio="1.25">
                      <components>
                        <component type="UISwitchComponent"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
            <element type="UIStack" name="PositionSectionCastlesBlack" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="PositionSectionCastleKbRow" flex="1" height="56" layout="Stack" direction="Horizontal" spacing="8" crossAlign="Center">
                  <components>
                    <component type="UIInputClicker"/>
                    <component type="UIToggleComponent" bind="editorCastleKb" action="ChessEditCastle" onValue="+k" offValue="-k"/>
                  </components>
                  <children>
                    <element type="UIElement" name="PositionSectionCastleKbCaption" flex="1" height="100%" fontSize="22">
                      <components>
                        <component type="UITextComponent" text="Black O-O" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                      </components>
                    </element>
                    <element type="UIElement" name="PositionSectionCastleKbSwitch" height="100%" aspectRatio="1.25">
                      <components>
                        <component type="UISwitchComponent"/>
                      </components>
                    </element>
                  </children>
                </element>
                <element type="UIElement" name="PositionSectionCastleQbRow" flex="1" height="56" layout="Stack" direction="Horizontal" spacing="8" crossAlign="Center">
                  <components>
                    <component type="UIInputClicker"/>
                    <component type="UIToggleComponent" bind="editorCastleQb" action="ChessEditCastle" onValue="+q" offValue="-q"/>
                  </components>
                  <children>
                    <element type="UIElement" name="PositionSectionCastleQbCaption" flex="1" height="100%" fontSize="22">
                      <components>
                        <component type="UITextComponent" text="Black O-O-O" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                      </components>
                    </element>
                    <element type="UIElement" name="PositionSectionCastleQbSwitch" height="100%" aspectRatio="1.25">
                      <components>
                        <component type="UISwitchComponent"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
            <element type="UIElement" name="PositionSectionMessage" height="28" fontSize="20">
              <components>
                <component type="UITextComponent" text="{editorMessage}" align="Center" verticalAlign="Center" wrap="false"/>
              </components>
            </element>
            <element type="UIStack" name="PositionSectionActions" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="PositionSectionPlay" flex="1" height="56" fontSize="26" color="50,115,85,255">
                  <components>
                    <component type="UITextComponent" text="Play from here" align="Center" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                    <component type="UIInputClicker" action="ChessEditPlay"/>
                  </components>
                </element>
                <element type="UIElement" name="PositionSectionCancel" flex="1" height="56" fontSize="26" color="112,84,48,255">
                  <components>
                    <component type="UITextComponent" text="Cancel editing" align="Center" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                    <component type="UIInputClicker" action="ChessEditCancel"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIStack" name="PositionSectionButtons" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="PositionSectionBack" flex="1" height="56" fontSize="26" color="50,115,85,255">
                  <components>
                    <component type="UITextComponent" text="Back" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessOpenMenu"/>
                  </components>
                </element>
              </children>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
