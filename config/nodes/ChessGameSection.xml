<?xml version="1.0"?>
<!-- The menu section "Game" (the list's "Resign / Draw"): the two ways to end a game that is not played to its end. A modal canvas over everything (layer 20, above the HUD and the
     end-of-game bar), started hidden, built like the section "Moves": the Resign / Draw button of the menu list shows it (ChessOpenSection, value game: the row of
     Game/MenuSections.cpp); the one button, Back, returns to the list (ChessOpenMenu) and fills its row; the dim is a button of its own that hides both (ChessCloseMenu)
     with stateLook="false", always the first child. ChessGameSectionComponent (listed before the canvas) answers ChessResign, ChessDraw, ChessGameYes and ChessGameNo and holds the one UI-only
     state, the question that is open: asking, Resign and Draw give way to the question line {gameQuestion} and the row Yes / No. A hidden element takes no room in a stack, so
     the plate holds four rows in either state: 16 + 44 (title) + 56 + 56 (Resign and Draw, or the question and Yes / No) + 56 (Back) + 3 x 12 (spacing) + 16 = 280 units high,
     which the safe area of every view has. The HUD's Resign (ChessResign with the section closed) shows the second plate GameSectionConfirm instead, the question and Yes / No
     alone, 16 + 56 + 12 + 56 + 16 = 156 units high: its No hides the canvas, back to the game, not to the menu. The component greys Resign and Draw (the clicker's disabled and the text's fadeWhenDisabled) while the game cannot take them. Every name
     starts with GameSection because elements are found by name in every canvas of the scene. -->
<node name="GameSection" layer="20" contentVersion="5">
  <components>
    <component type="ChessGameSectionComponent" />
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIElement" name="GameSectionDim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,150" blocksInput="true">
          <components>
            <component type="UIInputClicker" action="ChessCloseMenu" stateLook="false"/>
          </components>
        </element>
        <element type="UIStack" name="GameSectionPlate" anchor="Center" width="94%" maxWidth="640" height="280" direction="Vertical" spacing="12" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UIElement" name="GameSectionTitle" height="44" fontSize="30">
              <components>
                <component type="UITextComponent" text="Resign / Draw" align="Center"/>
              </components>
            </element>
            <element type="UIElement" name="GameSectionQuestion" height="56" fontSize="28" visible="false">
              <components>
                <component type="UITextComponent" text="{gameQuestion}" align="Center" verticalAlign="Center" wrap="false"/>
              </components>
            </element>
            <element type="UIElement" name="GameSectionResign" height="56" fontSize="26" color="112,84,48,255">
              <components>
                <component type="UITextComponent" text="Resign" align="Center" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                <component type="UIInputClicker" action="ChessResign"/>
              </components>
            </element>
            <element type="UIElement" name="GameSectionDraw" height="56" fontSize="26" color="70,70,100,255">
              <components>
                <component type="UITextComponent" text="Draw" align="Center" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                <component type="UIInputClicker" action="ChessDraw"/>
              </components>
            </element>
            <element type="UIStack" name="GameSectionAnswers" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch" visible="false">
              <children>
                <element type="UIElement" name="GameSectionYes" flex="1" height="56" fontSize="26" color="50,115,85,255">
                  <components>
                    <component type="UITextComponent" text="Yes" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessGameYes"/>
                  </components>
                </element>
                <element type="UIElement" name="GameSectionNo" flex="1" height="56" fontSize="26" color="110,60,60,255">
                  <components>
                    <component type="UITextComponent" text="No" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessGameNo"/>
                  </components>
                </element>
              </children>
            </element>
            <element type="UIStack" name="GameSectionButtons" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="GameSectionBack" flex="1" height="56" fontSize="26" color="50,115,85,255">
                  <components>
                    <component type="UITextComponent" text="Back" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessOpenMenu"/>
                  </components>
                </element>
              </children>
            </element>
          </children>
        </element>
        <element type="UIStack" name="GameSectionConfirm" anchor="Center" width="94%" maxWidth="640" height="156" direction="Vertical" spacing="12" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true" visible="false">
          <children>
            <element type="UIElement" name="GameSectionConfirmQuestion" height="56" fontSize="28">
              <components>
                <component type="UITextComponent" text="{gameQuestion}" align="Center" verticalAlign="Center" wrap="false"/>
              </components>
            </element>
            <element type="UIStack" name="GameSectionConfirmAnswers" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="GameSectionConfirmYes" flex="1" height="56" fontSize="26" color="50,115,85,255">
                  <components>
                    <component type="UITextComponent" text="Yes" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessGameYes"/>
                  </components>
                </element>
                <element type="UIElement" name="GameSectionConfirmNo" flex="1" height="56" fontSize="26" color="110,60,60,255">
                  <components>
                    <component type="UITextComponent" text="No" align="Center" verticalAlign="Center" wrap="false"/>
                    <component type="UIInputClicker" action="ChessGameNo"/>
                  </components>
                </element>
              </children>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
