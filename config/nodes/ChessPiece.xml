<?xml version="1.0"?>
<!-- A piece node is the whole square (ChessPieceComponent writes its position and size). fit="Contain" draws the sprite inside it with the aspect of its
     sprite, centered, so the piece is not stretched and the highlights of the board, which are full squares, still sit around it. -->
<node name="Piece" contentVersion="5">
  <components>
    <component type="TransformComponent" x="0" y="0" width="80" height="80" />
    <component type="SpriteRendererComponent" spriteId="WhitePawn" fit="Contain" />
    <component type="ChessPieceComponent" file="0" rank="0" />
  </components>
</node>
