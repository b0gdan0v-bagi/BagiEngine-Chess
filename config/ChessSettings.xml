<?xml version="1.0"?>
<!--
  Settings of the computer opponent and of the memory of the game.

  stockfishPath: the full path of a Stockfish you installed (the game does not ship one).
    Leave it empty to use the environment variable STOCKFISH and then "stockfish" on PATH.
    Put your own path in config/ChessSettings.local.xml, which git ignores, not here:
    this file is committed and has to stay empty.

  rememberGame: "true" restores the unfinished game and the opponent choice at the start and saves them as you play.
    Set "false" in config/ChessSettings.local.xml to start every run new. A run with --control, --control-port, --headless or --manual-clock does not save, unless --save-dir is given.
-->
<ChessSettings stockfishPath="" rememberGame="true"/>
