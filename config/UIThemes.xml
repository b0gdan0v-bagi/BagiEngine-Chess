<?xml version="1.0"?>
<!-- The colors the board draws (ChessBoardComponent through BoardPalette) and the coordinate labels of the node BoardCoordinates take as `@token`. Every theme defines every token
     (ExpectThemesComplete), so a new theme is a new <theme> with the same eleven names; BoardPaletteTest checks each theme for marks that cannot be seen or told apart.
     boardLight / boardDark are the two squares; the labels of the board use boardDark on a light cell and boardLight on a dark one. The other nine are drawn over a square with their
     alpha: the selection and its legal targets, a capture target, the check and the mate, the hint (the square the piece leaves, the square it goes to), the last move and the premoves.
     `classic` (the default) is the look the board had before the themes and belongs to the graphics preset Classic; `tavern` is a pale cream table and dark oak, chosen so that the
     golden beer pieces stand out on the light squares and the near-black ones on the dark squares, and belongs to the preset Beer (ThemeOf() of Graphics/GraphicsPreset.h); `slate` has
     cool grey-blue squares with marks chosen to be seen on them and belongs to no preset. -->
<UIThemes default="classic">
  <theme id="classic">
    <color name="boardLight" value="240,217,181,255"/>
    <color name="boardDark" value="181,136,99,255"/>
    <color name="boardSelected" value="120,200,120,200"/>
    <color name="boardLegalMove" value="120,200,120,120"/>
    <color name="boardLegalCapture" value="220,90,90,160"/>
    <color name="boardCheck" value="230,60,60,210"/>
    <color name="boardMate" value="150,20,20,240"/>
    <color name="boardHintFrom" value="60,130,230,110"/>
    <color name="boardHintTo" value="60,130,230,200"/>
    <color name="boardLastMove" value="245,205,50,140"/>
    <color name="boardPremove" value="150,90,200,150"/>
  </theme>
  <theme id="slate">
    <color name="boardLight" value="196,205,218,255"/>
    <color name="boardDark" value="98,117,142,255"/>
    <color name="boardSelected" value="40,200,110,215"/>
    <color name="boardLegalMove" value="40,200,110,110"/>
    <color name="boardLegalCapture" value="225,80,80,170"/>
    <color name="boardCheck" value="235,55,60,215"/>
    <color name="boardMate" value="120,10,25,245"/>
