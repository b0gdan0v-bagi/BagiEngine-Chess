<?xml version="1.0"?>
<SceneManager>
  <scenes>
    <scene
      type="Scene"
      name="ChessScene"
      viewWidth="840"
      viewHeight="800">
      <nodes>
        <!-- Background layer: nodes with a lower layer are drawn first, the pieces (layer 0) on top. -->
        <node name="Board" layer="-1">
          <components>
            <component type="ChessBoardComponent" originX="100" originY="80" squareSize="80" />
          </components>
        </node>

        <!-- The letters and numbers at the edges of the board. A canvas of UILabels (the renderer has no text primitive) on the same layer as the Board, written right after it:
             same layer, scene order, so it is drawn after the squares and the highlights of ChessBoardComponent and before the pieces (layer 0), the result bar (1), the HUD (10) and
             the panels (20). The canvas has no safe area: the board stands at fixed scene units (view 840 x 800, the board 640 x 640 at (100, 80)) and an inset must not move a label.
             The labels take no click (no blocksInput, not interactive), so the board gets every press. Rank numbers sit in the left column of cells (RankLabel<row>, row from the
             top), top-left in the cell; file letters in the bottom row (FileLabel<column>), bottom-right in the cell. The rects are fixed on the screen; the text is a variable that
             ChessBoardComponent publishes from Game/BoardCoordinates.h (coordRank<row>, coordFile<column>), so it turns with the board (h..a and 1..8 while the program plays White).
             A box is 13 x 26 units (the line of an 18-unit font is about 24 units high, and a box under it cuts the glyph) in the 13-unit corner (x 2..15 or 65..78 of the 80-unit cell) that a piece never reaches: a Contain-fitted piece covers about 15.5..64.5.
             The contrast is static: a turn by 180 degrees keeps the color of a cell, so a label has the dark brown of the dark squares on a light cell and the cream on a dark one
             (a cell is light when column + row is even; the rank labels are in column 0, the file labels in row 7). Font 18: about 10 px at the narrowest fit scale (0.57). -->
        <node name="BoardCoordinates" layer="-1">
          <components>
            <component type="UICanvasComponent" space="SceneView" useSafeArea="false">
              <elements>
                <element type="UILabel" name="RankLabel0" x="102" y="82" width="13" height="26" text="{coordRank0}" fontSize="18" align="Left" verticalAlign="Top" overflow="Clip" wrap="false" textColor="181,136,99,255" />
                <element type="UILabel" name="RankLabel1" x="102" y="162" width="13" height="26" text="{coordRank1}" fontSize="18" align="Left" verticalAlign="Top" overflow="Clip" wrap="false" textColor="240,217,181,255" />
                <element type="UILabel" name="RankLabel2" x="102" y="242" width="13" height="26" text="{coordRank2}" fontSize="18" align="Left" verticalAlign="Top" overflow="Clip" wrap="false" textColor="181,136,99,255" />
                <element type="UILabel" name="RankLabel3" x="102" y="322" width="13" height="26" text="{coordRank3}" fontSize="18" align="Left" verticalAlign="Top" overflow="Clip" wrap="false" textColor="240,217,181,255" />
                <element type="UILabel" name="RankLabel4" x="102" y="402" width="13" height="26" text="{coordRank4}" fontSize="18" align="Left" verticalAlign="Top" overflow="Clip" wrap="false" textColor="181,136,99,255" />
                <element type="UILabel" name="RankLabel5" x="102" y="482" width="13" height="26" text="{coordRank5}" fontSize="18" align="Left" verticalAlign="Top" overflow="Clip" wrap="false" textColor="240,217,181,255" />
                <element type="UILabel" name="RankLabel6" x="102" y="562" width="13" height="26" text="{coordRank6}" fontSize="18" align="Left" verticalAlign="Top" overflow="Clip" wrap="false" textColor="181,136,99,255" />
                <element type="UILabel" name="RankLabel7" x="102" y="642" width="13" height="26" text="{coordRank7}" fontSize="18" align="Left" verticalAlign="Top" overflow="Clip" wrap="false" textColor="240,217,181,255" />
                <element type="UILabel" name="FileLabel0" x="165" y="692" width="13" height="26" text="{coordFile0}" fontSize="18" align="Right" verticalAlign="Bottom" overflow="Clip" wrap="false" textColor="240,217,181,255" />
                <element type="UILabel" name="FileLabel1" x="245" y="692" width="13" height="26" text="{coordFile1}" fontSize="18" align="Right" verticalAlign="Bottom" overflow="Clip" wrap="false" textColor="181,136,99,255" />
                <element type="UILabel" name="FileLabel2" x="325" y="692" width="13" height="26" text="{coordFile2}" fontSize="18" align="Right" verticalAlign="Bottom" overflow="Clip" wrap="false" textColor="240,217,181,255" />
                <element type="UILabel" name="FileLabel3" x="405" y="692" width="13" height="26" text="{coordFile3}" fontSize="18" align="Right" verticalAlign="Bottom" overflow="Clip" wrap="false" textColor="181,136,99,255" />
                <element type="UILabel" name="FileLabel4" x="485" y="692" width="13" height="26" text="{coordFile4}" fontSize="18" align="Right" verticalAlign="Bottom" overflow="Clip" wrap="false" textColor="240,217,181,255" />
                <element type="UILabel" name="FileLabel5" x="565" y="692" width="13" height="26" text="{coordFile5}" fontSize="18" align="Right" verticalAlign="Bottom" overflow="Clip" wrap="false" textColor="181,136,99,255" />
                <element type="UILabel" name="FileLabel6" x="645" y="692" width="13" height="26" text="{coordFile6}" fontSize="18" align="Right" verticalAlign="Bottom" overflow="Clip" wrap="false" textColor="240,217,181,255" />
                <element type="UILabel" name="FileLabel7" x="725" y="692" width="13" height="26" text="{coordFile7}" fontSize="18" align="Right" verticalAlign="Bottom" overflow="Clip" wrap="false" textColor="181,136,99,255" />
              </elements>
            </component>
          </components>
        </node>

        <!-- The captured pieces and the balance of the material, in the left margin of the view (x 0 to 100; the board is 100 to 740). A canvas of the SceneView space with no safe area,
             like BoardCoordinates: it is at fixed scene units next to the board, and ChessMaterialComponent decides what a narrow window with insets leaves of it. Layer 5: over the pieces (0)
             and the result bar (1), under the HUD (10) and the panels (20); the component is listed before the canvas so that it gives the variables their words before the canvas draws in the
             same frame. Nothing here takes a click (no blocksInput, nothing interactive, not modal), so the board and the Reset button get every press. The right margin is left free.
             Two groups mirrored about the middle of the board: the lower one (MaterialBottom*, y 500) is what the color at the bottom of the board has taken, the upper one (MaterialTop*, y 84)
             what the other color has taken; they swap when the board turns. A group is a list of five rows in the order queen, rook, bishop, knight, pawn, each a chip with the picture of a piece
             (a UIImage whose sprite the component sets: the pieces of the other color than the group's) and the count "x3"; a row of a piece that has not been taken is hidden and takes no room, so the
             rows pack at the top of the list. The list is 64 x 216 at x 8 (5 x 40 + 4 x 4) and, with the balance box, is held by Game/MaterialLayout.h: the rows are shown only while the
             lists lie inside the safe area (in the narrowest case of the size matrix, a 480 px window with side insets, the safe area starts at about x = 75.6 and about 24 units of the margin are left). The balance, "+3" on the side that is ahead and nothing
             on the other, is a box of 23 x 28 units at the board's edge (x 77 to 100) whose AutoFit shrinks the text (to 12 units at the smallest) instead of cutting it, and it is never hidden. The names all start with
             Material because elements are found by name in every canvas of the scene. The chip is a cream a little darker than the light squares (so that a test can tell a chip from a square), the text
             a dark brown that is not one of the two colors of the board's labels. The look (the colors, the sizes of the font, the pictures at this size) is a first guess nobody has seen in a window. -->
        <node name="Material" layer="5">
          <components>
            <component type="ChessMaterialComponent" />
            <component type="UICanvasComponent" space="SceneView" useSafeArea="false">
              <elements>
                <element type="UIStack" name="MaterialTopList" x="8" y="84" width="64" height="216" direction="Vertical" spacing="4" crossAlign="Stretch">
                  <children>
                    <element type="UIStack" name="MaterialTopQueenRow" height="40" direction="Horizontal" spacing="4" padding="2" crossAlign="Stretch" color="232,210,170,255" visible="false">
                      <children>
                        <element type="UIImage" name="MaterialTopQueenIcon" width="26" />
                        <element type="UILabel" name="MaterialTopQueenCount" flex="1" text="{materialTopQueen}" fontSize="20" align="Center" verticalAlign="Center" overflow="Clip" wrap="false" textColor="70,45,30,255" />
                      </children>
                    </element>
                    <element type="UIStack" name="MaterialTopRookRow" height="40" direction="Horizontal" spacing="4" padding="2" crossAlign="Stretch" color="232,210,170,255" visible="false">
                      <children>
                        <element type="UIImage" name="MaterialTopRookIcon" width="26" />
                        <element type="UILabel" name="MaterialTopRookCount" flex="1" text="{materialTopRook}" fontSize="20" align="Center" verticalAlign="Center" overflow="Clip" wrap="false" textColor="70,45,30,255" />
                      </children>
                    </element>
                    <element type="UIStack" name="MaterialTopBishopRow" height="40" direction="Horizontal" spacing="4" padding="2" crossAlign="Stretch" color="232,210,170,255" visible="false">
                      <children>
                        <element type="UIImage" name="MaterialTopBishopIcon" width="26" />
                        <element type="UILabel" name="MaterialTopBishopCount" flex="1" text="{materialTopBishop}" fontSize="20" align="Center" verticalAlign="Center" overflow="Clip" wrap="false" textColor="70,45,30,255" />
                      </children>
                    </element>
                    <element type="UIStack" name="MaterialTopKnightRow" height="40" direction="Horizontal" spacing="4" padding="2" crossAlign="Stretch" color="232,210,170,255" visible="false">
                      <children>
                        <element type="UIImage" name="MaterialTopKnightIcon" width="26" />
                        <element type="UILabel" name="MaterialTopKnightCount" flex="1" text="{materialTopKnight}" fontSize="20" align="Center" verticalAlign="Center" overflow="Clip" wrap="false" textColor="70,45,30,255" />
                      </children>
                    </element>
                    <element type="UIStack" name="MaterialTopPawnRow" height="40" direction="Horizontal" spacing="4" padding="2" crossAlign="Stretch" color="232,210,170,255" visible="false">
                      <children>
                        <element type="UIImage" name="MaterialTopPawnIcon" width="26" />
                        <element type="UILabel" name="MaterialTopPawnCount" flex="1" text="{materialTopPawn}" fontSize="20" align="Center" verticalAlign="Center" overflow="Clip" wrap="false" textColor="70,45,30,255" />
                      </children>
                    </element>
                  </children>
                </element>
                <element type="UILabel" name="MaterialTopBalance" x="77" y="84" width="23" height="28" text="{materialTopBalance}" fontSize="20" minFontSize="12" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" />
                <element type="UIStack" name="MaterialBottomList" x="8" y="500" width="64" height="216" direction="Vertical" spacing="4" crossAlign="Stretch">
                  <children>
                    <element type="UIStack" name="MaterialBottomQueenRow" height="40" direction="Horizontal" spacing="4" padding="2" crossAlign="Stretch" color="232,210,170,255" visible="false">
                      <children>
                        <element type="UIImage" name="MaterialBottomQueenIcon" width="26" />
                        <element type="UILabel" name="MaterialBottomQueenCount" flex="1" text="{materialBottomQueen}" fontSize="20" align="Center" verticalAlign="Center" overflow="Clip" wrap="false" textColor="70,45,30,255" />
                      </children>
                    </element>
                    <element type="UIStack" name="MaterialBottomRookRow" height="40" direction="Horizontal" spacing="4" padding="2" crossAlign="Stretch" color="232,210,170,255" visible="false">
                      <children>
                        <element type="UIImage" name="MaterialBottomRookIcon" width="26" />
                        <element type="UILabel" name="MaterialBottomRookCount" flex="1" text="{materialBottomRook}" fontSize="20" align="Center" verticalAlign="Center" overflow="Clip" wrap="false" textColor="70,45,30,255" />
                      </children>
                    </element>
                    <element type="UIStack" name="MaterialBottomBishopRow" height="40" direction="Horizontal" spacing="4" padding="2" crossAlign="Stretch" color="232,210,170,255" visible="false">
                      <children>
                        <element type="UIImage" name="MaterialBottomBishopIcon" width="26" />
                        <element type="UILabel" name="MaterialBottomBishopCount" flex="1" text="{materialBottomBishop}" fontSize="20" align="Center" verticalAlign="Center" overflow="Clip" wrap="false" textColor="70,45,30,255" />
                      </children>
                    </element>
                    <element type="UIStack" name="MaterialBottomKnightRow" height="40" direction="Horizontal" spacing="4" padding="2" crossAlign="Stretch" color="232,210,170,255" visible="false">
                      <children>
                        <element type="UIImage" name="MaterialBottomKnightIcon" width="26" />
                        <element type="UILabel" name="MaterialBottomKnightCount" flex="1" text="{materialBottomKnight}" fontSize="20" align="Center" verticalAlign="Center" overflow="Clip" wrap="false" textColor="70,45,30,255" />
                      </children>
                    </element>
                    <element type="UIStack" name="MaterialBottomPawnRow" height="40" direction="Horizontal" spacing="4" padding="2" crossAlign="Stretch" color="232,210,170,255" visible="false">
                      <children>
                        <element type="UIImage" name="MaterialBottomPawnIcon" width="26" />
                        <element type="UILabel" name="MaterialBottomPawnCount" flex="1" text="{materialBottomPawn}" fontSize="20" align="Center" verticalAlign="Center" overflow="Clip" wrap="false" textColor="70,45,30,255" />
                      </children>
                    </element>
                  </children>
                </element>
                <element type="UILabel" name="MaterialBottomBalance" x="77" y="500" width="23" height="28" text="{materialBottomBalance}" fontSize="20" minFontSize="12" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" />
              </elements>
            </component>
          </components>
        </node>

        <!-- The HUD is in the margins of the view (space="SceneView"): it scales and moves with the board and never covers it, whatever the shape of the window.
             The board is 640 x 640 at (100, 80); the margin is 80 units above and below, so one row of 56-unit controls fits in each (12 units from the edge of the
             safe area), and a 56-unit button is still a 32 px touch target at the smallest fit scale of the size matrix (0.57, the 840 units of the width in a 480 px window).
             The top row is Turn (left), Menu and Reset (right); the bottom margin holds only Status (bottom right). Every element is anchored to a corner, so the row is
             as wide as the safe area, which is about 689 units in the narrowest window of the matrix (480 px with side insets): Turn (320), Menu (110) and Reset (110) with
             their gaps add up to less than that, and ChessUiTest lays every word the game can show into them. Menu is the one button that opens the opponent panel (the
             node OpponentPanel below): it emits ChessOpenOpponent, is always shown, and its text is the fixed word "Menu", not a state; the side, the engine and the level
             are chosen in the panel, which also shows what is picked now, and not on buttons of the HUD: the margins are full. -->
        <node name="Hud" layer="10">
          <components>
            <component type="UICanvasComponent" space="SceneView" useSafeArea="true">
              <elements>
                <element type="UILabel" name="Turn" x="12" y="12" width="320" height="56" text="{turn}" fontSize="28" verticalAlign="Center" />
                <element type="UIButton" name="Menu" anchor="TopRight" x="-134" y="12" width="110" height="56" text="Menu" fontSize="24" action="ChessOpenOpponent" color="45,75,120,255" />
                <element type="UIButton" name="Reset" anchor="TopRight" x="-12" y="12" width="110" height="56" text="Reset" fontSize="26" action="ChessReset" color="40,90,60,255" />
                <element type="UILabel" name="Status" anchor="BottomRight" x="-12" y="-12" width="48%" height="56" text="{status}" fontSize="28" align="Right" verticalAlign="Center" />
              </elements>
            </component>
          </components>
        </node>

        <!-- The opponent panel: a modal canvas over everything (layer 20, above the HUD and the end-of-game bar), started hidden. The Menu button of the HUD shows it
             (ChessOpenOpponent) and OK hides it (ChessCloseOpponent); while it is shown the dim takes every click, so the board gets none. Four choice groups (UISegmented), a
             caption beside each. A segment emits its action with its id as the value (ChessSetMode / ChessSetColor / ChessSetEngine / ChessSetLevel); ChessBoardComponent applies
             the pick at once and publishes the ids the groups are bound to (opponentMode, opponentColor, opponentEngine, opponentLevel), so the panel stays open and always shows
             what the game really has. The ids are those of the control API; the color is the PERSON's color (the program plays the other one). No group is greyed: a color or a level picked
             while two people play is remembered and applies when Computer is picked, and the engine can be picked at any time (the person needs it exactly when the Stockfish
             pick was refused). A pick of an engine that cannot be had changes nothing, the error line says why. The groups are named ModeGroup, ColorGroup, EngineGroup and LevelGroup and not Mode, Engine and Level on purpose: elements are found by name in every
             canvas of the scene. OpponentError is the sentence of the engine's error ({opponentError}, empty when there is none). A segment needs an explicit height (a flex
             segment without one gets a rect of height 0). The plate is 16 + 44 (title) + 4 x 56 (rows) + 32 (error) + 56 (OK) + 6 x 12 (spacing) + 16 = 460 units high. The view
             is a fixed 840 x 800, so there is no portrait variant. -->
        <node name="OpponentPanel" layer="20">
          <components>
            <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
              <elements>
                <element type="UIElement" name="Dim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,150" blocksInput="true" />
                <element type="UIStack" name="Plate" anchor="Center" width="94%" maxWidth="640" height="460" direction="Vertical" spacing="12" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
                  <children>
                    <element type="UILabel" name="Title" height="44" text="Opponent" fontSize="30" align="Center" />
                    <element type="UIStack" name="ModeRow" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
                      <children>
                        <element type="UILabel" name="ModeCaption" width="150" height="56" text="Opponent" fontSize="24" verticalAlign="Center" />
                        <element type="UISegmented" name="ModeGroup" bind="opponentMode" flex="1" height="56" direction="Horizontal" spacing="4" color="30,30,30,255">
                          <children>
                            <element type="UIButton" name="ModeTwo" flex="1" height="56" text="Two players" fontSize="24" value="two" action="ChessSetMode" color="70,70,100,255" />
                            <element type="UIButton" name="ModeComputer" flex="1" height="56" text="Computer" fontSize="24" value="computer" action="ChessSetMode" color="70,70,100,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UIStack" name="ColorRow" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
                      <children>
                        <element type="UILabel" name="ColorCaption" width="150" height="56" text="Play as" fontSize="24" verticalAlign="Center" />
                        <element type="UISegmented" name="ColorGroup" bind="opponentColor" flex="1" height="56" direction="Horizontal" spacing="4" color="30,30,30,255">
                          <children>
                            <element type="UIButton" name="ColorWhite" flex="1" height="56" text="White" fontSize="24" value="white" action="ChessSetColor" color="70,70,100,255" />
                            <element type="UIButton" name="ColorBlack" flex="1" height="56" text="Black" fontSize="24" value="black" action="ChessSetColor" color="70,70,100,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UIStack" name="EngineRow" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
                      <children>
                        <element type="UILabel" name="EngineCaption" width="150" height="56" text="Engine" fontSize="24" verticalAlign="Center" />
                        <element type="UISegmented" name="EngineGroup" bind="opponentEngine" flex="1" height="56" direction="Horizontal" spacing="4" color="30,30,30,255">
                          <children>
                            <element type="UIButton" name="EngineStockfish" flex="1" height="56" text="Stockfish" fontSize="24" value="stockfish" action="ChessSetEngine" color="70,70,100,255" />
                            <element type="UIButton" name="EngineOwn" flex="1" height="56" text="Own engine" fontSize="24" value="own" action="ChessSetEngine" color="70,70,100,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UIStack" name="LevelRow" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
                      <children>
                        <element type="UILabel" name="LevelCaption" width="150" height="56" text="Level" fontSize="24" verticalAlign="Center" />
                        <element type="UISegmented" name="LevelGroup" bind="opponentLevel" flex="1" height="56" direction="Horizontal" spacing="4" color="30,30,30,255">
                          <children>
                            <element type="UIButton" name="LevelEasy" flex="1" height="56" text="Easy" fontSize="24" value="easy" action="ChessSetLevel" color="70,70,100,255" />
                            <element type="UIButton" name="LevelMedium" flex="1" height="56" text="Medium" fontSize="24" value="medium" action="ChessSetLevel" color="70,70,100,255" />
                            <element type="UIButton" name="LevelHard" flex="1" height="56" text="Hard" fontSize="24" value="hard" action="ChessSetLevel" color="70,70,100,255" />
                            <element type="UIButton" name="LevelMax" flex="1" height="56" text="Max" fontSize="24" value="max" action="ChessSetLevel" color="70,70,100,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UILabel" name="OpponentError" height="32" text="{opponentError}" fontSize="22" align="Center" verticalAlign="Center" textColor="240,120,120,255" />
                    <element type="UIButton" name="Ok" height="56" text="OK" fontSize="26" action="ChessCloseOpponent" color="50,115,85,255" />
                  </children>
                </element>
              </elements>
            </component>
          </components>
        </node>

        <!-- The promotion panel: a modal canvas over everything (layer 20, like the opponent panel), started hidden. A click on a promotion target does not move the pawn: the model
             leaves the promotion pending (ChessGameModel::HasPendingPromotion) and ChessBoardComponent shows this canvas for as long as it is, on every update, so a reset, a set_state or
             a move of the program or of the control API closes a panel that has become stale. A piece button emits ChessPromote with the id of the piece as the value ("queen", "rook",
             "bishop", "knight": the table of PromotionChoices) and plays the move; Cancel emits ChessCancelPromotion and the pawn stays selected. While it is shown the dim takes every
             click, so the board and the buttons of the HUD under it get none; there is no Escape and no click outside to cancel. Plain text buttons, no pieces drawn in them. The names
             start with Promotion or Promote because elements are found by name in every canvas of the scene (the opponent panel has Dim, Plate and Title). The four piece buttons share
             one row. The plate is 94% of the safe area up to 640 units, and 94% of even the narrowest safe area (about 689 units, so 647) is more than 640: the plate is 640 wide in
             every window of the size matrix, 608 inside the padding, so a button is 146 units wide and keeps 8 units of air around "Knight" at font 26 everywhere (ChessUiTest holds
             it). The plate is 16 + 44 (title) + 56 (pieces) + 56 (Cancel) + 3 x 12 (spacing) + 16 = 224 units high.
             The view is a fixed 840 x 800, so there is no portrait variant. -->
        <node name="PromotionPanel" layer="20">
          <components>
            <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
              <elements>
                <element type="UIElement" name="PromotionDim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,150" blocksInput="true" />
                <element type="UIStack" name="PromotionPlate" anchor="Center" width="94%" maxWidth="640" height="224" direction="Vertical" spacing="12" padding="16" crossAlign="Stretch" color="44,38,52,255" blocksInput="true">
                  <children>
                    <element type="UILabel" name="PromotionTitle" height="44" text="Promote to" fontSize="30" align="Center" />
                    <element type="UIStack" name="PromotionPieces" height="56" direction="Horizontal" spacing="8" crossAlign="Stretch">
                      <children>
                        <element type="UIButton" name="PromoteQueen" flex="1" height="56" text="Queen" fontSize="26" value="queen" action="ChessPromote" color="70,70,100,255" />
                        <element type="UIButton" name="PromoteRook" flex="1" height="56" text="Rook" fontSize="26" value="rook" action="ChessPromote" color="70,70,100,255" />
                        <element type="UIButton" name="PromoteBishop" flex="1" height="56" text="Bishop" fontSize="26" value="bishop" action="ChessPromote" color="70,70,100,255" />
                        <element type="UIButton" name="PromoteKnight" flex="1" height="56" text="Knight" fontSize="26" value="knight" action="ChessPromote" color="70,70,100,255" />
                      </children>
                    </element>
                    <element type="UIButton" name="PromotionCancel" height="56" text="Cancel" fontSize="26" action="ChessCancelPromotion" color="110,60,60,255" />
                  </children>
                </element>
              </elements>
            </component>
          </components>
        </node>

        <!-- Foreground layer: the end-of-game dim and result bar, drawn over the pieces (layer 0). -->
        <node name="Result" layer="1">
          <components>
            <component type="ChessResultComponent" />
          </components>
        </node>

        <!-- A piece node is the whole square (ChessPieceComponent writes its position and size). fit="Contain" draws the sprite inside it with the aspect of its
             atlas cell, centered, so the piece is not stretched and the highlights of the board, which are full squares, still sit around it. -->

        <!-- White back rank (rank 0) -->
        <node name="WhiteRook_a1">
          <components>
